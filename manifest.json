{
  "manifest_version": 3,
  "name": "YojanaGPT",
  "version": "1.0",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:11434/*",
    "http://localhost:11434/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}